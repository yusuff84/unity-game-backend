# Port Mapping on Host
WEB_PORT=8001
DB_PORT_HOST=5434

# Django General Settings
SECRET_KEY=django-insecure-change-this-in-production-key-unity-game-123456
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,web

# PostgreSQL Settings
DB_NAME=unity_game
DB_USER=unity_user
DB_PASSWORD=unity_password
DB_HOST=db
DB_PORT=5432

# CORS Configuration (Unity WebGL domain)
# Set to True for open access during dev, or specify exact origins
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8080,http://127.0.0.1:8080

# SimpleJWT Settings
ACCESS_TOKEN_LIFETIME_MINUTES=60
REFRESH_TOKEN_LIFETIME_DAYS=7

# Production Security & HTTPS Settings
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
USE_X_FORWARDED_PROTO=True
